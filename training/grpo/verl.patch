+def patch_qwen3_vl_fast_pos_embed_interpolate():
+    """Make Qwen3VLVisionModel.fast_pos_embed_interpolate device-robust.
+
+    The upstream implementation builds idx_tensor / weight_tensor with
+    `device=self.pos_embed.weight.device`. Under FSDP2 (with or without
+    param_offload) the wrapped Embedding's .weight can read as cpu while
+    other gathered params and inputs are on cuda, raising
+    "Expected all tensors to be on the same device" inside `self.pos_embed(idx_tensor)`.
+
+    This patch derives the device from the input grid_thw (which the caller
+    is responsible for placing on the active device) and falls back to
+    pos_embed.weight.device.
+    """
+    try:
+        from transformers.models.qwen3_vl.modeling_qwen3_vl import Qwen3VLVisionModel
+    except ImportError:
+        return
+
+    original_fn = Qwen3VLVisionModel.fast_pos_embed_interpolate
+
+    @functools.wraps(original_fn)
+    def patched(self, grid_thw):
+        if isinstance(grid_thw, torch.Tensor) and grid_thw.is_cuda:
+            target_device = grid_thw.device
+        else:
+            weight = self.pos_embed.weight
+            local = getattr(weight, "_local_tensor", None)
+            target_device = local.device if local is not None else weight.device
+
+        grid_ts, grid_hs, grid_ws = grid_thw[:, 0], grid_thw[:, 1], grid_thw[:, 2]
+
+        idx_list = [[] for _ in range(4)]
+        weight_list = [[] for _ in range(4)]
+
+        for t, h, w in zip(grid_ts, grid_hs, grid_ws):
+            h_idxs = torch.linspace(0, self.num_grid_per_side - 1, int(h))
+            w_idxs = torch.linspace(0, self.num_grid_per_side - 1, int(w))
+
+            h_idxs_floor = h_idxs.int()
+            w_idxs_floor = w_idxs.int()
+            h_idxs_ceil = (h_idxs.int() + 1).clip(max=self.num_grid_per_side - 1)
+            w_idxs_ceil = (w_idxs.int() + 1).clip(max=self.num_grid_per_side - 1)
+
+            dh = h_idxs - h_idxs_floor
+            dw = w_idxs - w_idxs_floor
+
+            base_h = h_idxs_floor * self.num_grid_per_side
+            base_h_ceil = h_idxs_ceil * self.num_grid_per_side
+
+            indices = [
+                (base_h[None].T + w_idxs_floor[None]).flatten(),
+                (base_h[None].T + w_idxs_ceil[None]).flatten(),
+                (base_h_ceil[None].T + w_idxs_floor[None]).flatten(),
+                (base_h_ceil[None].T + w_idxs_ceil[None]).flatten(),
+            ]
+            weights = [
+                ((1 - dh)[None].T * (1 - dw)[None]).flatten(),
+                ((1 - dh)[None].T * dw[None]).flatten(),
+                (dh[None].T * (1 - dw)[None]).flatten(),
+                (dh[None].T * dw[None]).flatten(),
+            ]
+            for i in range(4):
+                idx_list[i].extend(indices[i].tolist())
+                weight_list[i].extend(weights[i].tolist())
+
+        idx_tensor = torch.tensor(idx_list, dtype=torch.long, device=target_device)
+        weight_tensor = torch.tensor(weight_list, dtype=self.pos_embed.weight.dtype, device=target_device)
+
+        pos_embeds = self.pos_embed(idx_tensor) * weight_tensor[:, :, None]
+        patch_pos_embeds = pos_embeds[0] + pos_embeds[1] + pos_embeds[2] + pos_embeds[3]
+
+        patch_pos_embeds = patch_pos_embeds.split([h * w for h, w in zip(grid_hs.tolist(), grid_ws.tolist())])
+
+        patch_pos_embeds_permute = []
+        merge_size = self.config.spatial_merge_size
+        for pos_embed, t, h, w in zip(patch_pos_embeds, grid_ts.tolist(), grid_hs.tolist(), grid_ws.tolist()):
+            pos_embed = pos_embed.repeat(t, 1)
+            pos_embed = (
+                pos_embed.view(t, h // merge_size, merge_size, w // merge_size, merge_size, -1)
+                .permute(0, 1, 3, 2, 4, 5)
+                .flatten(0, 4)
+            )
+            patch_pos_embeds_permute.append(pos_embed)
+        return torch.cat(patch_pos_embeds_permute)
+
+    Qwen3VLVisionModel.fast_pos_embed_interpolate = patched
+    logger.info("Monkey patched Qwen3VLVisionModel.fast_pos_embed_interpolate for FSDP2 device safety")

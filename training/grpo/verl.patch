+def qwen2_5_vl_video_fps(processor, video_metadatas):
+    """[tga-patch 2026-09-27] Real sampling fps of each video for Qwen2.5-VL; None for any other processor.
+
+    Qwen2.5-VL encodes time only through second_per_grid_ts = temporal_patch_size / fps. Both the HF processor
+    (transformers 4.57) and vLLM's Qwen2.5-VL processor take `fps` from call kwargs (default 2.0) and ignore
+    video_metadata, so without this every video is treated as if it were sampled at 2 fps.
+    fps = sampled frames / duration, the same definition as qwen_vl_utils' sample_fps.
+    """
+    if processor is None or type(processor).__name__ != "Qwen2_5_VLProcessor" or not video_metadatas:
+        return None
+    fps_list = []
+    for meta in video_metadatas:
+        fps = float(meta["fps"])
+        idx, total = meta.get("frames_indices"), meta.get("total_num_frames")
+        n = len(idx) if idx is not None else 0
+        fps_list.append(n * fps / float(total) if n and total else fps)
+    import os
+    if os.environ.get("TGA_Q25_FPS_TRUNC") == "1":
+        # [tga-patch 2026-10-05] Match the official HF evaluation: transformers 4.57 truncates second_per_grid_t = 2/fps to an
+        # integer k; replacing fps by 2/k (k >= 1) gives exactly k both in the rollout (vLLM, float) and on the training side
+        # (verl float + bf16 emulation), as in our evaluation. Without TGA_Q25_FPS_TRUNC the behaviour is unchanged.
+        import torch
+        out = []
+        for f in fps_list:
+            k = int(torch.as_tensor(torch.tensor(2.0 / f, dtype=torch.float32), dtype=torch.int64).item())
+            out.append(2.0 / k if k >= 1 else 1e6)
+        fps_list = out
+    return fps_list

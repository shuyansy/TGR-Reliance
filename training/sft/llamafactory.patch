+
+class OfficialVideoDecodeError(RuntimeError):
+    r"""A video that the official sampler (decord) cannot read after retries; the example is dropped during preprocessing."""
+
+
+def _official_oasis_video(path: str):
+    r"""Returns (video tensor (T, C, H, W) float32, metadata or None, video kwargs, family) exactly as the official sampler."""
+    global _OFFICIAL_LOGGED
+    import time as _time
+
+    from . import official_vision_process as _vp
+
+    fam = os.environ.get("LF_OASIS_FAMILY")
+    if fam not in _OFFICIAL_DEFAULTS:
+        raise ValueError("LF_VIDEO_SAMPLING=official_oasis requires LF_OASIS_FAMILY=qwen25|qwen3")
+    if not _OFFICIAL_LOGGED:
+        print(f"[lf-sampler] LF_VIDEO_SAMPLING=official_oasis family={fam} (pid {os.getpid()})", flush=True)
+        _OFFICIAL_LOGGED = True
+    d = _OFFICIAL_DEFAULTS[fam]
+    ele = {"type": "video", "video": path, "min_pixels": d["min_pixels"], "max_pixels": d["max_pixels"],
+           "total_pixels": d["total_pixels"], "min_frames": 4, "max_frames": 128, "fps": 1.0}
+    messages = [[{"role": "user", "content": [ele]}]]
+    n_try = int(os.environ.get("LF_OASIS_DECODE_RETRIES", "5"))
+    for k in range(n_try):
+        if fam == "qwen3":
+            _, vids, kw = _vp.process_vision_info(messages, image_patch_size=16, return_video_kwargs=True, return_video_metadata=True)
+        else:
+            _, vids, kw = _vp.process_vision_info(messages, return_video_kwargs=True)
+        if vids and vids[0] is not None:
+            break
+        print(f"[lf-sampler] official sampler failed ({k + 1}/{n_try}), retrying: {path}", flush=True)
+        _time.sleep(2 * (k + 1))
+    else:
+        raise OfficialVideoDecodeError(path)
+    if fam == "qwen3":
+        video, meta = vids[0]
+        return video, dict(meta), dict(kw), fam
+    return vids[0], None, dict(kw), fam

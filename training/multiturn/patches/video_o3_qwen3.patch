@@ -0,0 +1,104 @@
+"""[vo3-q3 2026-10-30] Single implementation of the Qwen3-VL video placeholder expansion, shared by the RL training sequences, the context length of the multi-turn engine, evaluation and SFT checks.
+
+A Qwen3-VL video is not a single <|vision_start|>pad...<|vision_end|> block (as in Qwen2.5-VL) but one block per temporal patch (2 frames):
+    "<{t:.1f} seconds>" + <|vision_start|> + <|video_pad|> × (h·w / 4) + <|vision_end|>
+t = mean of the first and last frame time of the patch, time = frames_indices[i] / fps (transformers Qwen3VLProcessor._calculate_timestamps,
+same as vLLM 0.11 Qwen3VLProcessingInfo._calculate_timestamps). In the prompt vLLM receives, each video is 3 tokens
+[<|vision_start|>, <|video_pad|>, <|vision_end|>], replaced by get_video_replacement_qwen3vl with the sequence above (each timestamp tokenized separately and concatenated).
+The training side of the official qwen3vl branch still writes a single block without timestamps as for Qwen2.5 (unlike what vLLM sees), and the positions only cover the first patch -> rebuilt here following vLLM.
+
+Metadata convention (our port): frames_indices = indices of the sampled frames in the 4 fps frame folder (grid), fps = grid fps 4.0 -> timestamps = absolute times in the original video
+(for both the overview and the crops; the official qwen3vl RL engine writes crop times relative to 0, the official qwen3vl evaluation uses absolute times).
+"""
+import os
+from typing import Dict, List, Optional, Sequence
+
+GRID_FPS = 4.0
+
+
+def think_prefill() -> str:
+    """[vo3-q3 2026-10-30] Optional: prefill "<think>\n" at the start of every assistant turn (VO3_THINK_PREFILL=1; default off = official). The Qwen3-VL-8B-Instruct backbone does not write <think> tags
+    (0 of 768 unforced trajectories in step 1 of the smoke test), so the official format score is always 0 and the tool bonus is never reached; the Qwen3 single-turn GRPO-only runs use the backbone with a prefilled <think>.
+    Decision (10-31): keep the Instruct backbone and use the prefill only for RL-only runs; prefill = "<think>\n", the same as the single-turn runs and the generation prefix of the official Qwen3-VL-Thinking template.
+    The prefilled tokens belong to the prompt (not trained); the reward manager adds this prefix back to every round before scoring with the original rules."""
+    return "<think>\n" if os.environ.get("VO3_THINK_PREFILL", "0") == "1" else ""
+
+
+PLACEHOLDER = "<|vision_start|><|video_pad|><|vision_end|>"
+
+
+def video_meta(frames_indices: Sequence[int], n_grid: int, grid_fps: float = GRID_FPS) -> Dict:
+    """Metadata of one (sampled) video: only keys known to transformers VideoMetadata (vLLM builds VideoMetadata from them)."""
+    idx = [int(i) for i in frames_indices]
+    assert idx, "frames_indices is empty"
+    return {"fps": float(grid_fps), "frames_indices": idx, "total_num_frames": int(n_grid), "duration": int(n_grid) / float(grid_fps)}
+
+
+def timestamps(meta: Dict, merge_size: int = 2) -> List[float]:
+    """Same as transformers Qwen3VLProcessor._calculate_timestamps / vLLM Qwen3VLProcessingInfo._calculate_timestamps (meta unchanged)."""
+    indices = list(meta["frames_indices"])
+    if len(indices) % merge_size != 0:
+        indices = indices + [indices[-1]] * (merge_size - len(indices) % merge_size)
+    ts = [i / meta["fps"] for i in indices]
+    return [(ts[i] + ts[i + merge_size - 1]) / 2 for i in range(0, len(ts), merge_size)]
+
+
+class Qwen3VideoExpander:
+    """tokenizer + video processor settings -> expanded tokens of a video placeholder (token-identical to vLLM 0.11 get_video_replacement_qwen3vl)."""
+
+    def __init__(self, processor):
+        tok = processor.tokenizer
+        self.tokenizer = tok
+        self.vs = tok.convert_tokens_to_ids("<|vision_start|>")
+        self.vp = tok.convert_tokens_to_ids("<|video_pad|>")
+        self.ve = tok.convert_tokens_to_ids("<|vision_end|>")
+        self.merge_size = int(processor.video_processor.merge_size)
+        self._ts_cache = {}
+
+    def _ts_ids(self, t: float) -> List[int]:
+        s = f"<{t:.1f} seconds>"
+        if s not in self._ts_cache:
+            self._ts_cache[s] = self.tokenizer.encode(s, add_special_tokens=False)
+        return self._ts_cache[s]
+
+    def expand(self, grid_thw, meta: Dict) -> List[int]:
+        """Full expansion of one video (including the timestamp before the first <|vision_start|> and the last <|vision_end|>), replacing the 3 placeholder tokens of the prompt."""
+        t, h, w = (int(x) for x in grid_thw)
+        ts = timestamps(meta, self.merge_size)
+        assert len(ts) == t, f"{len(ts)} timestamps != {t} temporal patches ({len(meta['frames_indices'])} frames_indices)"
+        per = h * w // (self.merge_size ** 2)
+        out: List[int] = []
+        for x in ts:
+            out += self._ts_ids(x)
+            out += [self.vs] + [self.vp] * per + [self.ve]
+        return out
+
+    def expand_len(self, grid_thw, meta: Dict) -> int:
+        return len(self.expand(grid_thw, meta))
+
+    def find_placeholders(self, ids: Sequence[int]) -> List[int]:
+        """Start positions of every video placeholder [vs, vp, ve] in the prompt tokens (vLLM matches this triple)."""
+        out, i, n = [], 0, len(ids)
+        while i + 2 < n:
+            if ids[i] == self.vs and ids[i + 1] == self.vp and ids[i + 2] == self.ve:
+                out.append(i)
+                i += 3
+            else:
+                i += 1
+        return out
+
+    def expand_ids(self, ids: Sequence[int], expansions: List[List[int]], mask: Optional[Sequence[int]] = None):
+        """Replace the video placeholders in ids, in order, with expansions (counts must match). If mask (same length as ids) is given it is expanded too: expanded tokens get mask 0.
+        Returns (new ids, new mask or None)."""
+        pos = self.find_placeholders(ids)
+        assert len(pos) == len(expansions), f"{len(pos)} video placeholders != {len(expansions)} videos"
+        out, om, last = [], ([] if mask is not None else None), 0
+        for p, e in zip(pos, expansions):
+            out += list(ids[last:p]) + list(e)
+            if mask is not None:
+                om += list(mask[last:p]) + [0] * len(e)
+            last = p + 3

+_TGA_ANS = re.compile(r"<answer>\s*\(?([A-Z])\)?\s*</answer>", re.S)
+_SPAN = re.compile(r"\[\s*(\d+(?:\.\d+)?)\s*,\s*(\d+(?:\.\d+)?)\s*\]")
+
+
+def _tga_answer(text):
+    m = _TGA_ANS.findall(text or "")
+    return m[-1] if m else None
+
+
+def _tga_union(spans):
+    out = []
+    for a, b in sorted(spans):
+        if out and a <= out[-1][1]:
+            out[-1][1] = max(out[-1][1], b)
+        else:
+            out.append([a, b])
+    return out
+
+
+def tiou(pred, gt):
+    P, G = _tga_union(pred), _tga_union(gt)
+    if not P or not G:
+        return 0.0
+    inter = sum(max(0.0, min(b1, b2) - max(a1, a2)) for a1, b1 in P for a2, b2 in G)
+    union = sum(b - a for a, b in P) + sum(b - a for a, b in G) - inter
+    return inter / union if union > 0 else 0.0

+"""[vo3-q3 2026-10-30] Frame sampling of the Qwen3 multi-turn SFT data, with exactly the rules of the RL engine and the evaluation,
+so that frames, resizing, timestamps and sampling notes are identical in all three:
+  4 fps grid  n = max(2, floor(total frames / avg fps * 4)), grid frame k = source frame min(round(k / 4 * avg fps), last frame)
+              (= extract_frames_4fps.py)
+  per frame   vo3_frame_worker.decode (long side > 1280 INTER_AREA, JPEG q95 round trip; = reading the frame folder)
+  overview    = RL dataset process_video_adaptive_token_num: 2 fps (SELF_SET_OVERVIEW_FPS), <= 768 frames, linspace on the grid,
+              per-frame pixel budget from a total of <= 16,384 / >= 512 tokens
+  crops       = RL tool function_tools_video.crop_video: grid frames inside the interval at 2 fps, budget coarse / medium / fine = 2,048 / 4,096 / 6,144
+              tokens (<= 768 per frame), floor 512
+  metadata    = verl/utils/vo3_qwen3.video_meta (grid indices, grid fps 4) -> timestamps = absolute times in the source video
+  notes       = the same sentence as the RL dataset / engine
+Frame selection and resizing reuse the RL code (RL/my_qwen_vl_utils/vision_process.py of this repository, loaded by path).
+"""
+import importlib.util
+import os
+
+import numpy as np
+import torch
+
+from . import vo3_frame_worker as FW
+
+RL = os.environ.get("VO3_RL_DIR") or os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "../../../../RL"))
+
+GRID_FPS = 4.0
+os.environ.setdefault("VISION_PATCH_SIZE", "16")
+assert os.environ["VISION_PATCH_SIZE"] == "16", "the resizing grid of Qwen3-VL is 32 (VISION_PATCH_SIZE=16)"
+
+
+def _load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+VP = _load("vo3_q3_vision_process", f"{RL}/my_qwen_vl_utils/vision_process.py")
+assert VP.IMAGE_FACTOR == 32, VP.IMAGE_FACTOR
+QV = _load("vo3_q3_qwen3", f"{RL}/verl/utils/vo3_qwen3.py")
+
+PPT = 32 * 32   # pixels per visual token (patch 16 x merge 2)
+
+
+def grid(mp4):
+    """4 fps grid of the whole video: [source frame index of every grid position] (= extract_frames_4fps)"""
+    vr = FW._reader(mp4)
+    total, fps = len(vr), float(vr.get_avg_fps())
+    del vr
+    n = max(2, int(np.floor(total / fps * GRID_FPS)))
+    return np.minimum(np.round(np.arange(n) / GRID_FPS * fps).astype(int), total - 1).tolist()
+
+
+def _take(ele, n_grid):
+    """Frame selection of vision_process._read_video_frame (line by line): returns (grid indices, sampling fps)"""
+    start_frame, end_frame, total_frames = VP.calculate_video_frame_range(ele, n_grid, GRID_FPS)
+    nframes = VP.smart_nframes(ele, total_frames=total_frames, video_fps=GRID_FPS)
+    idx = torch.linspace(start_frame, end_frame, nframes).round().long().tolist()
+    return idx, nframes / max(total_frames, 1e-6) * GRID_FPS
+
+
+def overview(mp4, src=None, max_tokens=16384, min_tokens=512, fps=None):
+    """Full overview -> (video tensor [T, 3, H, W] float, metadata, sampling note), as RL MultiModalDatasetVideo.__getitem__ + process_video_adaptive_token_num"""
+    src = grid(mp4) if src is None else src
+    fps = float(os.environ.get("SELF_SET_OVERVIEW_FPS", 2.0)) if fps is None else fps
+    idx, sample_fps = _take({"video": mp4, "fps": fps, "source_frames_fps": GRID_FPS}, len(src))
+    raw = torch.from_numpy(FW.decode(mp4, [src[i] for i in idx]))
+    frames_num = raw.shape[0]
+    ele = {"max_pixels": (max_tokens // (frames_num // 2)) * PPT, "min_pixels": (min_tokens // (frames_num // 2)) * PPT}
+    video, sample_fps = VP.resample_video_from_raw(raw, sample_fps, ele, return_video_sample_fps=True)
+    ti = f"This video is uniformly sampled at {(sample_fps):.2f} fps, contains {video.shape[0]} frames from 0 seconds to {(video.shape[0]/sample_fps-0.05):.1f} seconds."
+    return video, QV.video_meta(idx, len(src), grid_fps=GRID_FPS), ti
+
+
+def crop(mp4, seg, strategy, src=None, frames_sample_fps=2.0, min_tokens=512, max_tokens=None, max_tokens_per_frame_cap=768):
+    """Crop -> (video tensor, metadata, sampling note), as the RL engine's process_tool_call: prepare_grounding_inputs_video clips the interval to
+    [0, grid duration] (the SFT data builder already applied the same rule; clipped again here), then crop_video samples / resizes"""
+    src = grid(mp4) if src is None else src
+    L = len(src) / GRID_FPS
+    t0, t1 = max(0.0, float(seg[0])), min(float(seg[1]), L)
+    assert t0 <= t1 - 1, f"crop interval {seg} is invalid for grid duration {L} (the tool parser would reject it)"
+    max_tokens = max_tokens or {"coarse": 2048, "medium": 4096, "fine": 6144}.get(strategy, 4096)
+    idx, sample_fps = _take({"video": mp4, "fps": frames_sample_fps, "video_start": t0, "video_end": t1, "source_frames_fps": GRID_FPS}, len(src))
+    raw = torch.from_numpy(FW.decode(mp4, [src[i] for i in idx]))
+    frames_num = raw.shape[0]
+    ele = {"max_pixels": min(max_tokens // (frames_num // 2), max_tokens_per_frame_cap) * PPT, "min_pixels": (min_tokens // (frames_num // 2)) * PPT}
+    video, fps = VP.resample_video_from_raw(raw, sample_fps, ele, return_video_sample_fps=True)
+    ti = f"This video is uniformly sampled at {(fps):.2f} fps, contains {video.shape[0]} frames from {(t0):.1f} seconds to {(t1):.1f} seconds."
+    return video, QV.video_meta(idx, len(src), grid_fps=GRID_FPS), ti
+
+
+def is_overview(v) -> bool:
+    """Flag of the video item itself: crop missing or [-1, -1] = full overview, otherwise a crop."""
+    cr = v.get("crop")
+    return cr is None or [float(x) for x in cr] == [-1.0, -1.0]
+
+
+def sample_videos(videos, per_sample=True):
+    """videos list of the Video-o3 SFT data ([{"url", "crop", "sample"}, ...]) -> [(tensor, metadata, sampling note), ...].
+    Each item is an overview or a crop according to its own crop flag, not its position: the LLaMA-Factory collator concatenates the video lists of
+    the samples in a batch before get_mm_inputs. With per_sample=True (process_messages, one sample) the structure is also checked: item 0 is the
+    overview, all others are crops; with per_sample=False (batch collation) the list must start with an overview."""
+    out, cache = [], {}
+    for i, v in enumerate(videos):
+        assert isinstance(v, dict) and "url" in v, f"not a Video-o3 SFT video item: {v!r}"
+        mp4 = v["url"]
+        if mp4 not in cache:
+            cache[mp4] = grid(mp4)
+        ov = is_overview(v)
+        if per_sample or i == 0:
+            assert ov == (i == 0), f"item {i} should be {'the overview' if i == 0 else 'a crop'} (per_sample={per_sample}): {v!r}"
+        if ov:
+            out.append(overview(mp4, cache[mp4]))
+        else:
+            out.append(crop(mp4, v["crop"], v.get("sample") or "medium", cache[mp4]))
+    return out

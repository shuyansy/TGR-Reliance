+++ b/SFT/src/llamafactory/data/vo3_frame_worker.py
@@ -0,0 +1,85 @@
+"""[vo3-q3] Frame decoding on the 4 fps grid: source video -> grid frames [N, 3, H, W] uint8, processed exactly as
+extract_frames_4fps.py (long side > 1280 resized with INTER_AREA, JPEG q95 round trip, as vision_process.load_frame reads frame folders).
+Only imports numpy / cv2 / decord, so it can also run in light subprocesses (decoding in threads of a long-lived process leaked memory)."""
+import cv2
+import decord
+import numpy as np
+
+LONG_SIDE = 1280
+
+
+def _reader(mp4, nt=None):
+    """Open a fresh reader each time; callers delete it right after use (a decord reader that decoded frames keeps decoding in the background)."""
+    if nt is not None:
+        return decord.VideoReader(mp4, num_threads=nt)
+    for nt in (2, 1):   # as extract_frames_4fps: two decoding threads first, then a single thread
+        try:
+            return decord.VideoReader(mp4, num_threads=nt)
+        except Exception:
+            if nt == 1:
+                raise
+
+
+def decode_retry(mp4, body):
+    """Run body(reader); if decoding fails part-way, decode the whole video again with a single-threaded reader (as extract_frames_4fps).
+    Under full CPU load, two-thread decord occasionally hits EOF timeouts on the last frames; single-thread decoding gives bitwise identical frames."""
+    vr = _reader(mp4)
+    try:
+        return body(vr)
+    except Exception as e:
+        print(f"[vo3-decode-retry] {mp4}: {type(e).__name__}: {e} -> retrying single-threaded", flush=True)
+    finally:
+        del vr
+    vr = _reader(mp4, nt=1)
+    try:
+        return body(vr)
+    finally:
+        del vr
+
+
+def encode_frame(fr, mp4, s):
+    """Source RGB frame -> (long side > 1280 resized with INTER_AREA) -> JPEG q95 bytes (1-D np.uint8)."""
+    h, w = fr.shape[:2]
+    if max(h, w) > LONG_SIDE:
+        sc = LONG_SIDE / max(h, w)
+        fr = cv2.resize(fr, (round(w * sc), round(h * sc)), interpolation=cv2.INTER_AREA)
+    ok, buf = cv2.imencode(".jpg", cv2.cvtColor(fr, cv2.COLOR_RGB2BGR), [cv2.IMWRITE_JPEG_QUALITY, 95])
+    if not ok:
+        raise RuntimeError(f"JPEG encoding failed: {mp4} frame {s}")
+    return buf
+
+
+def decode_jpeg(buf):
+    """JPEG bytes -> RGB [H', W', 3] uint8."""
+    img = cv2.imdecode(buf, cv2.IMREAD_COLOR)
+    cv2.cvtColor(img, cv2.COLOR_BGR2RGB, img)
+    return img
+
+
+def proc_frame(fr, mp4, s):
+    """Source RGB frame [H, W, 3] -> grid frame RGB [H', W', 3] uint8 (identical to reading the frame folder)."""
+    return decode_jpeg(encode_frame(fr, mp4, s))
+
+
+def decode(mp4, src_list):
+    """src_list: source frame indices (repeats and any order allowed) -> [len(src_list), 3, H, W] uint8 in src_list order."""
+    pos = {}
+    for i, s in enumerate(src_list):
+        pos.setdefault(s, []).append(i)
+    need = sorted(pos)
+
+    def body(vr):
+        out = None
+        for c in range(0, len(need), 64):
+            part = need[c:c + 64]
+            arr = vr.get_batch(part).asnumpy()
+            for s, fr in zip(part, arr):
+                img = proc_frame(fr, mp4, s)
+                if out is None:
+                    out = np.empty((len(src_list), 3) + img.shape[:2], dtype=np.uint8)
+                chw = img.transpose(2, 0, 1)
+                for i in pos[s]:
+                    out[i] = chw
+            del arr
+        return out
+    return decode_retry(mp4, body)

--- /dev/null
+++ b/RL/verl/utils/vo3_memcheck.py
@@ -0,0 +1,389 @@
+"""[vo3-q3 2026-10-30] Integrity checks of the actor's FSDP parameters and optimizer states.
+
+Why: in the first RL smoke test after porting to Qwen3, at global_step_3 the first 96 KiB of the flat parameter of vision block 0 on rank 0
+(24,576 fp32 values: all norm1/norm2 weights and biases + the first 17 1/3 rows of attn.qkv.weight) were overwritten by another block of fp32 data
+(192 highly correlated 128-d vectors, like intermediate attention results), a change no optimizer step can produce; all other tensors were intact.
+The parameters were still correct during the step-3 rollout and broke between the rollout weight sync and the update forward, a period in which the
+main writer to GPU memory in this process is vLLM (it shares PyTorch's caching allocator with FSDP). Root cause unconfirmed (suspect: vLLM 0.11's
+default cascade attention schedules FA3 with num_splits=32 but does not pass num_splits in the call; probes with cascade on over thousands of calls never caught a change).
+
+Two modes:
+  VO3_PARAM_GUARD=1 (default on): at the end of every update, the actor parameters of this rank (local shards of every FSDP unit) and all optimizer
+      states (every tensor in state, including step; plus the param_groups hyperparameters and non-tensor values) are copied to host memory; before the
+      next update and before every checkpoint they are compared byte by byte (not a checksum). Any differing byte (including NaN contents, permuted
+      elements, changes that cancel out) makes all ranks raise (the launch script resumes from the last checkpoint, which passed the same check).
+      Covered: any byte change of these states between two updates (validation / checkpointing / rollout / ref) is detected before the next update or checkpoint.
+      Not covered: corruption during the update itself (forward / backward / optimizer step), module buffers (e.g. rotary inv_freq), gradients,
+      vLLM's own weights (re-synced from FSDP at every wake-up), the ref model (CPU-offloaded) and the LR scheduler object.
+      Cost: host memory per rank ~ bytes of parameters + optimizer states (Qwen3-VL-8B: ~13 GB, ~106 GB for 8 GPUs); each check / snapshot copies them to host in a few seconds.
+  VO3_MEMCHECK=1 (default off, for debugging): the same byte-by-byte comparison also after every step of vLLM wake-up / sleep, around ref and after log_prob
+      (changes are logged, not raised, and the current values become the new baseline); after an update the size of the change is checked (|delta| <= VO3_MEMCHECK_UPDATE_TOL);
+      after every execute_model a **heuristic** fast comparison (integer sums of the bit patterns of all / even / every-third elements of each tensor; may miss
+      changes that keep these sums), followed by a byte-by-byte comparison if it changed; counts cascade attention calls; with VO3_MEMCHECK_HISTORY=1 the
+      GPU allocation history is recorded and dumped when something happens.
+"""
+import os
+import time
+
+import torch
+
+_S = {"units": None}
+_CHUNK_BYTES = 64 << 20   # block size moved from GPU to host per step of the byte-by-byte comparison
+
+
+def guard_on() -> bool:
+    return os.environ.get("VO3_PARAM_GUARD", "1") == "1"
+
+
+def probe_on() -> bool:
+    return os.environ.get("VO3_MEMCHECK", "0") == "1"
+
+
+def _log(msg: str):
+    print(msg, flush=True)
+    d = _S.get("log_dir")
+    if d:
+        try:
+            with open(os.path.join(d, f"memcheck_rank{_S.get('rank', 0)}.log"), "a") as f:
+                f.write(f"{time.strftime('%m-%d %H:%M:%S')} {msg}\n")
+        except Exception as e:  # a failed log write does not affect training, but must be visible
+            print(f"[vo3-memcheck] cannot write the log: {e!r}", flush=True)
+
+
+def _sync():
+    if torch.cuda.is_available():
+        torch.cuda.synchronize()
+
+
+def _shard(fp):
+    t = getattr(fp, "_local_shard", None)
+    return t if t is not None else fp.data
+
+
+def register(fsdp_module, optimizer, rank: int):
+    """Called once after init_model (actor)."""
+    if not (guard_on() or probe_on()):
+        return
+    from torch.distributed.fsdp import FullyShardedDataParallel as FSDP
+    units = []
+    for name, m in fsdp_module.named_modules():
+        if not isinstance(m, FSDP):
+            continue
+        h = getattr(m, "_handle", None)
+        if h is None or getattr(h, "flat_param", None) is None:
+            continue
+        fp = h.flat_param
+        first = (getattr(fp, "_fqns", None) or ["?"])[0]
+        units.append((fp, f"{name or '<root>'}[{first}…]"))
+    _S.update(units=units, opt=optimizer, rank=rank, snap=None, scalars=None, cheap=None, staging=None, n_exec=0, n_bad=0, casc=0,
+              casc_last=None, casc_at_check=0, hist=False, last_sched=None, log_dir=os.environ.get("VO3_MEMCHECK_DIR") or None)
+    if _S["log_dir"]:
+        os.makedirs(_S["log_dir"], exist_ok=True)
+    refresh("register")
+    if rank == 0:
+        n = sum(_shard(fp).numel() for fp, _ in units)
+        _log(f"[vo3-memcheck] registered {len(units)} actor FSDP units ({n / 1e9:.2f} G elements in this rank's shards); guard {'on' if guard_on() else 'off'} / probe {'on' if probe_on() else 'off'};"
+             f" byte-by-byte snapshots kept in host memory (optimizer states exist only after the first update)")
+
+
+def _install_cascade_counter():
+    if not torch.cuda.is_available():
+        return
+    try:
+        import vllm.v1.attention.backends.flash_attn as fa
+    except Exception as e:
+        _log(f"[vo3-memcheck] cannot install the cascade counter: {e!r}")
+        return
+    if getattr(fa.cascade_attention, "_vo3_wrapped", False):
+        return
+    orig = fa.cascade_attention
+
+    def wrapped(output, query, *a, **k):
+        _S["casc"] += 1
+        _S["casc_last"] = (int(query.shape[0]), k.get("common_prefix_len"), k.get("max_query_len"))
+        return orig(output, query, *a, **k)
+
+    wrapped._vo3_wrapped = True
+    fa.cascade_attention = wrapped
+
+
+def _targets():
+    """Tensors to guard (fixed order): local shards of every FSDP unit; all tensors of every parameter in the optimizer state (param_groups order, sorted keys; including step)."""
+    out = [(f"param {nm}", _shard(fp)) for fp, nm in _S["units"]]
+    opt = _S.get("opt")
+    if opt is not None:
+        names = {id(fp): nm for fp, nm in _S["units"]}
+        for g in opt.param_groups:
+            for p in g["params"]:
+                st = opt.state.get(p) or {}
+                for k in sorted(st):
+                    if torch.is_tensor(st[k]):
+                        out.append((f"optimizer {k} {names.get(id(p), '?')}", st[k]))
+    return out
+
+
+def _scalars() -> str:
+    """Hyperparameters of the optimizer param_groups (lr / betas / eps / weight_decay ...) and non-tensor values of the state, compared exactly (repr of floats is reversible)."""
+    opt = _S.get("opt")
+    if opt is None:
+        return ""
+    gs = [sorted((k, repr(v)) for k, v in g.items() if k != "params") for g in opt.param_groups]
+    ns = [sorted((k, repr(v)) for k, v in (opt.state.get(p) or {}).items() if not torch.is_tensor(v)) for g in opt.param_groups for p in g["params"]]
+    return repr(gs) + "|" + repr(ns)
+
+
+def _bits(t):
+    """View a tensor as its bit pattern (NaN contents and +-0 count too); only for the heuristic fast comparison."""
+    v = t.detach().reshape(-1)
+    return v.view({4: torch.int32, 2: torch.int16, 1: torch.uint8}[v.element_size()]) if v.element_size() in (1, 2, 4) else None
+
+
+def _every(b, k):
+    """b[0::k] of a 1-D tensor (written with as_strided, equivalent; on CPU tests a FakeTensor emulating CUDA would initialise real CUDA with a strided slice)"""
+    return b.as_strided(((b.numel() + k - 1) // k,), (k * b.stride(0),), b.storage_offset())
+
+
+@torch.no_grad()
+def _cheap():
+    """Heuristic fast comparison used by the probe mode after every execute_model: 3 integers per tensor (sum of the bit patterns of all / even / every-third elements).
+    Each tensor is reduced on its own device (parameters / moments on GPU, AdamW step on host), grouped and concatenated per device, moved to host once per group, then joined in a fixed device order
+    (second review on 10-30: stacking GPU and host summaries directly failed with mixed devices once the host-side step existed after the first update)."""
+    rows = {}
+    for _, t in _targets():
+        b = _bits(t)
+        if b is None or b.numel() == 0:
+            continue
+        rows.setdefault(str(b.device), []).append(
+            torch.stack([b.sum(dtype=torch.int64), _every(b, 2).sum(dtype=torch.int64), _every(b, 3).sum(dtype=torch.int64)]))
+    if not rows:
+        return torch.zeros(0, 3, dtype=torch.int64)
+    return torch.cat([torch.stack(rows[d]).cpu() for d in sorted(rows)])
+
+
+@torch.no_grad()
+def refresh(tag: str):
+    """New baseline after an update (or after registration / checkpoint loading): all guarded tensors copied byte by byte to host (existing buffers reused)."""
+    if _S.get("units") is None:
+        return
+    _sync()
+    t0 = time.time()
+    old = dict(_S.get("snap") or [])
+    snap, nbytes = [], 0
+    for nm, t in _targets():
+        b = old.get(nm)
+        if b is None or b.shape != t.shape or b.dtype != t.dtype:
+            b = torch.empty(t.shape, dtype=t.dtype, device="cpu")
+        b.copy_(t.detach())
+        snap.append((nm, b))
+        nbytes += b.numel() * b.element_size()
+    _S["snap"], _S["scalars"] = snap, _scalars()
+    if probe_on():
+        _S["cheap"] = _cheap()
+    if _S["rank"] == 0:
+        _log(f"[vo3-memcheck] rank0 '{tag}' snapshot of {len(snap)} tensors, {nbytes / 2**30:.2f} GiB, {time.time() - t0:.1f} s")
+
+
+def _staging():
+    if _S.get("staging") is None:
+        try:
+            _S["staging"] = torch.empty(_CHUNK_BYTES, dtype=torch.uint8, pin_memory=torch.cuda.is_available())
+        except Exception:
+            _S["staging"] = torch.empty(_CHUNK_BYTES, dtype=torch.uint8)
+    return _S["staging"]
+
+
+@torch.no_grad()
+def _diff(t, b, tol=None):
+    """Byte-by-byte comparison of t (any device) with the host snapshot b (with tol: numeric |delta| > tol instead). Returns None if identical, else a dict (changed elements / first and last index / max |delta|)."""
+    if t.shape != b.shape or t.dtype != b.dtype:
+        return {"why": f"shape / dtype changed {tuple(b.shape)} {b.dtype} -> {tuple(t.shape)} {t.dtype}"}
+    ft, fb = t.detach().reshape(-1), b.reshape(-1)
+    n, es = ft.numel(), ft.element_size()
+    if n == 0:
+        return None
+    step = max(1, _CHUNK_BYTES // es)
+    stg = _staging()
+    cnt, first, last, maxd = 0, None, None, 0.0
+    for off in range(0, n, step):
+        c = ft[off:off + step]
+        m = c.numel()
+        if c.is_cuda:
+            s = stg[:m * es].view(c.dtype)
+            s.copy_(c)
+        else:
+            s = c
+        sb, bb = s.view(torch.uint8), fb[off:off + m].view(torch.uint8)
+        if tol is None and torch.equal(sb, bb):
+            continue
+        if tol is None:
+            bad = (sb.view(m, es) != bb.view(m, es)).any(1)
+        else:
+            dd = (s.double() - fb[off:off + m].double()).abs()
+            bad = ~(dd <= tol)   # NaN counts as exceeding
+        idx = bad.nonzero().squeeze(1)
+        if idx.numel() == 0:
+            continue
+        cnt += idx.numel()
+        first = off + int(idx[0]) if first is None else first
+        last = off + int(idx[-1])
+        if s.dtype.is_floating_point:
+            d = (s[idx].double() - fb[off:off + m][idx].double()).abs()
+            maxd = max(maxd, float(torch.nan_to_num(d, nan=float("inf"), posinf=float("inf")).max()))
+    if cnt == 0:
+        return None
+    return {"n": cnt, "first": first, "last": last, "maxd": maxd, "es": es, "ptr": t.data_ptr() if t.is_cuda else None}
+
+
+@torch.no_grad()
+def _compare():
+    snap = _S.get("snap") or []
+    tg = _targets()
+    probs = []
+    if [nm for nm, _ in tg] != [nm for nm, _ in snap]:
+        only = sorted(set(nm for nm, _ in tg) ^ set(nm for nm, _ in snap))
+        probs.append(("tensor list", None, {"why": f"snapshot {len(snap)} / now {len(tg)}; present on one side only (first 6): {only[:6]}"}))
+    sm = dict(snap)
+    for nm, t in tg:
+        b = sm.get(nm)
+        if b is not None:
+            r = _diff(t, b)
+            if r is not None:
+                probs.append((nm, t, r))
+    if _scalars() != _S.get("scalars"):
+        probs.append(("optimizer hyperparameters / non-tensor state", None, {"why": "param_groups hyperparameters or non-tensor state values changed"}))
+    return probs
+
+
+def _neighbors(ptr: int, nbytes: int) -> str:
+    try:
+        segs = torch.cuda.memory_snapshot()
+    except Exception as e:
+        return f"(cannot read the allocator snapshot {e!r})"
+    out = []
+    for sg in segs:
+        a0 = sg["address"]
+        if not (a0 <= ptr < a0 + sg["total_size"]):
+            continue
+        addr, prev = a0, None
+        for b in sg["blocks"]:
+            ba = b.get("address", addr)
+            if ba + b["size"] == ptr:
+                prev = b
+            if ba < ptr + nbytes and ptr < ba + b["size"]:
+                fr = b.get("frames") or []
+                where = " ← ".join(f"{x.get('filename', '?').split('/')[-1]}:{x.get('line', '?')}:{x.get('name', '?')}" for x in fr[:4])
+                out.append(f"overlapping block @{ba - ptr:+d} size {b['size']} requested {b.get('requested_size')} state {b['state']}{(' allocated at ' + where) if where else ''}")
+            addr = ba + b["size"]
+        if prev is not None:
+            fr = prev.get("frames") or []
+            where = " ← ".join(f"{x.get('filename', '?').split('/')[-1]}:{x.get('line', '?')}:{x.get('name', '?')}" for x in fr[:6])
+            out.append(f"preceding block size {prev['size']} requested {prev.get('requested_size')} state {prev['state']}{(' allocated at ' + where) if where else ''}")
+        out.append(f"segment start @{a0 - ptr:+d}, {sg['total_size']} bytes, pool {sg.get('segment_pool_id')}, stream {sg.get('stream')}")
+    return "; ".join(out) if out else "(no allocator segment contains this address)"
+
+
+def _report(tag: str, probs):
+    casc = _S["casc"] - _S["casc_at_check"]
+    _log(f"[vo3-memcheck] !!! rank{_S['rank']} at '{tag}': actor parameters / optimizer states differ byte by byte from the last snapshot ({len(probs)} items); "
+         f"{casc} cascade attention calls since the last check (last {_S['casc_last']}), last execute_model batch {_S['last_sched']}")
+    for nm, t, r in probs[:16]:
+        if "why" in r:
+            _log(f"[vo3-memcheck]     {nm}: {r['why']}")
+            continue
+        msg = (f"{nm} ({t.numel()} elements): {r['n']} changed, flat indices {r['first']}-{r['last']}"
+               f" (bytes {r['first'] * r['es']}-{(r['last'] + 1) * r['es']}), max |delta| {r['maxd']:.4g}")
+        if r.get("ptr") is not None and torch.cuda.is_available():
+            msg += f", address {r['ptr']:#x}; " + _neighbors(r["ptr"] + r["first"] * r["es"], (r["last"] - r["first"] + 1) * r["es"])
+        _log(f"[vo3-memcheck]     {msg}")
+    if len(probs) > 16:
+        _log(f"[vo3-memcheck]     ... {len(probs) - 16} more items")
+    if probe_on() and os.environ.get("VO3_MEMCHECK_HISTORY", "1") == "1" and _S.get("hist") and _S["log_dir"]:
+        p = os.path.join(_S["log_dir"], f"memsnap_rank{_S['rank']}_{_S['n_bad']}.pickle")
+        try:
+            torch.cuda.memory._dump_snapshot(p)
+            _log(f"[vo3-memcheck]     allocation history snapshot -> {p}")
+        except Exception as e:
+            _log(f"[vo3-memcheck]     cannot dump the allocation history: {e!r}")
+    _S["n_bad"] += 1
+
+
+def check(tag: str, collective: bool = False):
+    """Between two updates the actor parameters and all optimizer states must equal the last snapshot byte by byte. In guard mode a mismatch raises (on all ranks with collective=True)."""
+    if _S.get("units") is None:
+        return
+    _sync()
+    t0 = time.time()
+    probs = _compare()
+    ok = not probs
+    if ok:
+        _S["casc_at_check"] = _S["casc"]
+    else:
+        _report(tag, probs)
+    if _S["rank"] == 0 and (collective or not ok):
+        _log(f"[vo3-memcheck] rank0 '{tag}' byte-by-byte check {'identical' if ok else 'DIFFERENT'}, {time.time() - t0:.1f} s")
+    any_bad = not ok
+    if collective and guard_on() and not probe_on() and torch.distributed.is_initialized():
+        flag = torch.tensor([0 if ok else 1], device="cuda" if torch.cuda.is_available() else "cpu")
+        torch.distributed.all_reduce(flag, op=torch.distributed.ReduceOp.MAX)
+        any_bad = bool(flag.item())
+    if any_bad and guard_on() and not probe_on():
+        raise RuntimeError(f"[vo3-guard] '{tag}': actor parameters / optimizer states were modified between two updates (byte-by-byte comparison; see the [vo3-memcheck] lines of every rank); "
+                           f"stopping this run; the launch script resumes from the last checkpoint")
+    if not ok and probe_on():   # probe mode: log, take the current values as the new baseline, keep looking
+        refresh(f"{tag} (new baseline after logging)")
+
+
+@torch.no_grad()
+def check_update(tag: str):
+    """New baseline after an update; the probe mode first checks the size of the parameter change (a legal update is of the order of lr 1e-6, far below the tolerance)."""
+    if _S.get("units") is None:
+        return
+    _sync()
+    if probe_on() and _S.get("snap"):
+        tol = float(os.environ.get("VO3_MEMCHECK_UPDATE_TOL", "1e-3"))
+        sm = dict(_S["snap"])
+        worst = []
+        for nm, t in _targets()[:len(_S["units"])]:   # parameters only (optimizer states change a lot in an update anyway)
+            b = sm.get(nm)
+            r = None if b is None else _diff(t, b, tol=tol)
+            if r is not None:
+                worst.append(f"{nm}: " + (r["why"] if "why" in r else f"|delta|>{tol:g} for {r['n']} elements, flat indices {r['first']}-{r['last']}, max {r['maxd']:.4g}"))
+        if worst:
+            _log(f"[vo3-memcheck] !!! rank{_S['rank']} '{tag}': change after the update exceeds the tolerance {tol:g} (an update should never be this large): " + " | ".join(worst[:8]))
+            _S["n_bad"] += 1
+    refresh(tag)
+
+
+def on_execute_model(args):
+    """Probe mode: heuristic fast comparison after vLLM execute_model (every VO3_MEMCHECK_EVERY calls); on a change, byte-by-byte comparison to locate it."""
+    if not probe_on() or _S.get("units") is None:
+        return
+    _S["n_exec"] += 1
+    if _S["n_exec"] == 1:   # vLLM is initialised by now; wrap cascade_attention (FlashAttentionImpl.forward looks it up by module-global name)
+        _install_cascade_counter()
+    try:
+        so = args[0] if args else None
+        _S["last_sched"] = (getattr(so, "total_num_scheduled_tokens", None), len(getattr(so, "num_scheduled_tokens", {}) or {}))
+    except Exception:
+        _S["last_sched"] = None
+    if not _S["hist"] and os.environ.get("VO3_MEMCHECK_HISTORY", "1") == "1":
+        try:
+            torch.cuda.memory._record_memory_history(max_entries=int(os.environ.get("VO3_MEMCHECK_HISTORY_N", "200000")), stacks="python")
+            _S["hist"] = True
+            if _S["rank"] == 0:
+                _log("[vo3-memcheck] allocation history recording on (from the first execute_model)")
+        except Exception as e:
+            _S["hist"] = None
+            _log(f"[vo3-memcheck] cannot enable the allocation history: {e!r}")
+    if _S["n_exec"] % int(os.environ.get("VO3_MEMCHECK_EVERY", "1")) == 0:
+        _sync()
+        cur = _cheap()
+        base = _S.get("cheap")
+        if base is None or base.shape != cur.shape or not torch.equal(cur, base):
+            check(f"execute_model#{_S['n_exec']} (heuristic comparison changed)")
+            _S["cheap"] = _cheap()
+
+
+def summary(tag: str):
+    if probe_on() and _S.get("units") is not None:
+        _log(f"[vo3-memcheck] rank{_S['rank']} '{tag}': {_S['n_exec']} execute_model calls in total, {_S['casc']} cascade attention calls, {_S['n_bad']} changes found")

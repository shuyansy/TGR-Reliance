+def vo3_expand_rounds(batch: DataProto, pad_id: int, world_size: int, ignore_exceed: bool, ignore_void: bool):
+    """[vo3-repro 2026-10-20] Context variants (VO3_CTX=A/B/D/CS): trajectory batch (group filtering / truncation / advantages computed on the original cumulative sequence) -> batch of per-round training rows.
+    One row per round of every trajectory: input = the context actually used for that round's generation + that round's response; the loss covers only the response tokens that the original (C) also trains (the engine takes them by position from C's attention x multi-turn mask,
+    and here we check that the training tokens of the rows add up to those of the trajectory in C). Advantage = the GRPO advantage of the whole trajectory (normalised within the group of 16, as in C).
+    Row coefficient = training tokens of the row / training tokens of the trajectory x world_size / number of trajectories: dp_actor multiplies each row's token-mean loss by it and updates once with all rows, which equals
+    the original "token mean per trajectory, equal trajectory weights, divided by the number of trajectories" (world_size cancels the FSDP gradient averaging across ranks).
+    Ordering: the vision-tower blocks are FSDP-wrapped separately, so within a micro-batch all ranks must either all run the vision tower or all skip it -> rows without video (A/D when all earlier crops failed) go first on every rank, with the same count per rank;
+    both groups are padded with zero-coefficient dummy rows to a multiple of world_size and balanced across ranks by token count. Row width = longest context + longest response of this batch (instead of C's 18432 + 32768).
+    Returns (row batch DataProto, statistics dict)"""
+    b, nt = batch.batch, batch.non_tensor_batch
+    T = len(batch)
+    L = b['responses'].size(1)
+    c_mask = (b['attention_mask'] * b['multi_turn_response_mask'])[:, -L:]
+    adv = b['advantages']
+    st = {k: 0 for k in ['traj_used', 'traj_mismatch', 'traj_exceed_skipped', 'traj_void_skipped', 'traj_no_loss', 'rows_no_loss',
+                         'loss_tokens_c', 'loss_tokens_rows', 'traj_tokens_c']}
+    items, bad_detail = [], []
+    for t in range(T):
+        rt = nt['vo3_rows'][t]
+        if ignore_exceed and bool(b['exceed_mask'][t]):
+            st['traj_exceed_skipped'] += 1
+            continue
+        if ignore_void and bool(b['void_mask'][t]):
+            st['traj_void_skipped'] += 1
+            continue
+        n_c = int(c_mask[t].sum())
+        if n_c == 0:
+            st['traj_no_loss'] += 1
+            continue
+        n_rows = sum(int(r['lm'].sum()) for r in rt) if isinstance(rt, list) else -1

+    def _group(g):
+        if not g:
+            return [[] for _ in range(world_size)]
+        short = min(g, key=lambda x: len(x['r']['ids']))
+        g = g + [{'r': short['r'], 'coef': 0.0, 'A': 0.0, 'dummy': True} for _ in range((-len(g)) % world_size)]
+        parts = get_seqlen_balanced_partitions([len(x['r']['ids']) for x in g], k_partitions=world_size, equal_size=True)
+        return [[g[i] for i in part] for part in parts]
+
+    text_parts = _group([x for x in items if not x['r']['videos']])
+    vid_parts = _group([x for x in items if x['r']['videos']])

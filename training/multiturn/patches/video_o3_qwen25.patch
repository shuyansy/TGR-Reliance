+def _vo3_crop_fps(n_frames, crop_interval, full_duration, grid_fps=4.0):
+    """[vo3-repro 2026-10-23] Sampling fps of a crop, computed as in the RL engine's crop_video: on the 4 fps grid (n_g = max(2, floor(duration * 4)) frames)
+    calculate_video_frame_range(start = ceil(s * 4), end = min(floor(e * 4), n_g - 1)); fps = sampled frames / grid frames in the range * 4"""
+    n_g = max(2, math.floor(full_duration * grid_fps))
+    max_d = n_g / grid_fps
+    s = max(0.0, min(float(crop_interval[0]), max_d))
+    e = max(0.0, min(float(crop_interval[1]), max_d))
+    start, end = math.ceil(s * grid_fps), min(math.floor(e * grid_fps), n_g - 1)
+    return n_frames / max(1, end - start + 1) * grid_fps
